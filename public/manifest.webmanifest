{
  "name": "Bubble Breaker - Classic Puzzle Game",
  "short_name": "Bubble Breaker",
  "description": "A classic bubble popping puzzle game with smooth animations and offline play",
  "display": "standalone",
  "orientation": "portrait-primary",
  "scope": "./",
  "start_url": "./",
  "theme_color": "#1976d2",
  "background_color": "#fafafa",
  "categories": ["games", "entertainment"],
