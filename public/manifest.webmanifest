  "shortcuts": [
    {
      "name": "New Game",
      "short_name": "New Game",
      "description": "Start a new bubble breaker game",
      "url": "/game",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "High Scores",
      "short_name": "Scores",
      "description": "View high scores and statistics",
      "url": "/scores",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Configure game settings",
      "url": "/settings",
      "icons": [{ "src": "icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-score",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "capture_links": "existing-client-navigate"
}
