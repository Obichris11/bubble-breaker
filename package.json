{
  "name": "bubble-breaker",
  "version": "2.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:e2e": "ng build --configuration production,e2e",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "check:pwa": "node scripts/check-pwa.mjs dist/bubble-breaker/browser",
    "check:container": "node scripts/check-container.mjs http://127.0.0.1:18080",
    "e2e": "playwright test -c e2e",
    "e2e:docker": "bash scripts/e2e-docker.sh",
    "lh": "node scripts/lighthouse.mjs",
    "test:deploy": "bash deploy/update.test.sh",
    "icons": "node scripts/make-icons.mjs",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
